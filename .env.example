NODE_ENV=development
PORT=3000

# MySQL (matches docker-compose.yml)
DATABASE_URL=mysql://inventory:inventory@localhost:3306/inventory

# Auth - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
COOKIE_SECURE=false
RUN_MIGRATIONS=false

# First admin created by `pnpm db:seed` for company SEED_COMPANY_ID (override with --company=<id>)
SEED_COMPANY_ID=1
SEED_ADMIN_EMAIL=admin@inventory.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Administrator

# config_inventory owns the companies and their configuration. Generate each key like the JWT secrets.
# CONFIG_SERVICE_KEY: sent by this API when it asks config_inventory about a company.
# INTERNAL_API_KEY: config_inventory must send it to call /api/internal/*.
CONFIG_SERVICE_URL=http://localhost:3100
CONFIG_SERVICE_KEY=change-me-config-service-key-at-least-32-chars
INTERNAL_API_KEY=change-me-internal-api-key-at-least-32-chars

# Docker compose only
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=inventory
MYSQL_USER=inventory
MYSQL_PASSWORD=inventory
