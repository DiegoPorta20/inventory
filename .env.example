NODE_ENV=development
PORT=3000

# MySQL (matches docker-compose.yml)
DATABASE_URL=mysql://inventory:inventory@localhost:3306/inventory

# Auth - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
COOKIE_SECURE=false
RUN_MIGRATIONS=false

# First admin created by `pnpm db:seed`
SEED_ADMIN_EMAIL=admin@inventory.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Administrator

# Docker compose only
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=inventory
MYSQL_USER=inventory
MYSQL_PASSWORD=inventory
